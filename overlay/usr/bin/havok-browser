#!/usr/bin/env python3
"""
Havok Browser - A minimal web browser built with WebKit2GTK.
"""
import sys, os, gi
gi.require_version('Gtk', '3.0')
gi.require_version('WebKit2', '4.1')
from gi.repository import Gtk, WebKit2, GLib, Pango

HOME_PAGE = 'https://start.duckduckgo.com/'
BG_COLOR = '#1a1a2e'
ACCENT = '#e94560'
TEXT_COLOR = '#e0e0e0'

class HavokBrowser(Gtk.Window):
    def __init__(self):
        super().__init__(title='Havok Browser')
        self.set_default_size(1024, 700)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Main vertical layout
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(vbox)

        # Navigation bar
        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        nav.set_margin_start(8)
        nav.set_margin_end(8)
        nav.set_margin_top(6)
        nav.set_margin_bottom(6)
        vbox.pack_start(nav, False, False, 0)

        btn_style = b'button { background: #16213e; color: white; border: none; border-radius: 4px; padding: 4px 10px; font-weight: bold; } button:hover { background: #0f3460; }'

        # Back
        self.back_btn = Gtk.Button(label='<')
        self.back_btn.set_size_request(36, 32)
        self._style_btn(self.back_btn, btn_style)
        self.back_btn.connect('clicked', lambda w: self.webview.go_back())
        nav.pack_start(self.back_btn, False, False, 0)

        # Forward
        self.fwd_btn = Gtk.Button(label='>')
        self.fwd_btn.set_size_request(36, 32)
        self._style_btn(self.fwd_btn, btn_style)
        self.fwd_btn.connect('clicked', lambda w: self.webview.go_forward())
        nav.pack_start(self.fwd_btn, False, False, 0)

        # Refresh
        self.refresh_btn = Gtk.Button(label='↻')
        self.refresh_btn.set_size_request(36, 32)
        self._style_btn(self.refresh_btn, btn_style)
        self.refresh_btn.connect('clicked', lambda w: self.webview.reload())
        nav.pack_start(self.refresh_btn, False, False, 0)

        # Home
        self.home_btn = Gtk.Button(label='⌂')
        self.home_btn.set_size_request(36, 32)
        self._style_btn(self.home_btn, btn_style)
        self.home_btn.connect('clicked', lambda w: self._go_home())
        nav.pack_start(self.home_btn, False, False, 0)

        # URL bar
        self.url_bar = Gtk.Entry()
        self.url_bar.set_hexpand(True)
        self.url_bar.set_placeholder_text('Enter URL...')
        self.url_bar.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA.parse('#16213e'))
        self.url_bar.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA.parse(TEXT_COLOR))
        self.url_bar.connect('activate', self._on_url_enter)
        nav.pack_start(self.url_bar, True, True, 0)

        # Go
        go_btn = Gtk.Button(label='Go')
        go_btn.set_size_request(50, 32)
        self._style_btn(go_btn, b'button { background: #e94560; color: white; border: none; border-radius: 4px; padding: 4px 10px; font-weight: bold; } button:hover { background: #c73652; }')
        go_btn.connect('clicked', lambda w: self._on_url_enter(self.url_bar))
        nav.pack_start(go_btn, False, False, 0)

        # Content area with status bar
        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        vbox.pack_start(content_box, True, True, 0)

        # Scrolled window for webview
        scrolled = Gtk.ScrolledWindow()
        content_box.pack_start(scrolled, True, True, 0)

        # WebView
        self.webview = WebKit2.WebView()
        self.webview.connect('load-changed', self._on_load_changed)
        self.webview.connect('enter-fullscreen', lambda w: self.fullscreen())
        self.webview.connect('leave-fullscreen', lambda w: self.unfullscreen())
        scrolled.add(self.webview)

        # Status bar
        self.status_bar = Gtk.Label()
        self.status_bar.set_margin_start(10)
        self.status_bar.set_margin_bottom(4)
        self.status_bar.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA.parse('#888'))
        content_box.pack_start(self.status_bar, False, False, 0)

        # Apply dark theme to webview
        settings = self.webview.get_settings()
        settings.set_enable_javascript(True)
        settings.set_user_agent('HavokBrowser/1.0 (HavokOS; WebKit)')

        # Style the window
        self.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA.parse(BG_COLOR))

        self.show_all()
        self._go_home()

    def _style_btn(self, btn, css_data):
        css = Gtk.CssProvider()
        css.load_from_data(css_data)
        btn.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA.parse(TEXT_COLOR))

    def _go_home(self):
        self.webview.load_uri(HOME_PAGE)

    def _on_url_enter(self, widget):
        url = widget.get_text().strip() if hasattr(widget, 'get_text') else self.url_bar.get_text().strip()
        if not url:
            return
        if not url.startswith('http://') and not url.startswith('https://') and not url.startswith('file://'):
            if '.' in url and ' ' not in url:
                url = 'https://' + url
            else:
                url = 'https://duckduckgo.com/?q=' + url.replace(' ', '+')
        self.webview.load_uri(url)

    def _on_load_changed(self, webview, event):
        if event == WebKit2.LoadEvent.FINISHED:
            uri = webview.get_uri()
            self.url_bar.set_text(uri)
            self.set_title(f'Havok Browser - {uri}')
            self.status_bar.set_text(f'Loaded: {uri}')
        elif event == WebKit2.LoadEvent.STARTED:
            self.status_bar.set_text('Loading...')

if __name__ == '__main__':
    from gi.repository import Gdk
    browser = HavokBrowser()
    browser.connect('destroy', Gtk.main_quit)
    Gtk.main()
